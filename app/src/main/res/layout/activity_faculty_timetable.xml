<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Faculty Timetable"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Faculty Selector -->
    <TextView
        android:id="@+id/facultyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Faculty Member:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/facultySpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp" />

    <!-- Daily Workload Summary -->
    <TextView
        android:id="@+id/workloadSummaryLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Workload Summary:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/workloadSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a faculty member to view workload"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="#F5F5F5" />

    <!-- Faculty Schedule Grid -->
    <TextView
        android:id="@+id/scheduleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Schedule:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/facultyScheduleRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Back Button -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Class View" />

</LinearLayout>
