<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Subject Name -->
        <TextView
            android:id="@+id/subjectNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Subject Name" />

        <!-- Period Counts Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Required Periods -->
            <TextView
                android:id="@+id/requiredPeriodsText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:text="Required: 0" />

            <!-- Assigned Periods -->
            <TextView
                android:id="@+id/assignedPeriodsText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:text="Assigned: 0" />

        </LinearLayout>

        <!-- Discrepancy Indicator -->
        <TextView
            android:id="@+id/discrepancyIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF0000"
            android:visibility="gone"
            android:text="⚠ Discrepancy detected!" />

        <!-- Assigned Slots Label -->
        <TextView
            android:id="@+id/assignedSlotsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Assigned Slots:" />

        <!-- Assigned Slots RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/assignedSlotsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
