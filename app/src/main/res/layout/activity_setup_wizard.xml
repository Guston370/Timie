<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_wizard_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Working Days Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/workingDaysLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/working_days_hint"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/workingDaysInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Day Names Input -->
        <TextView
            android:id="@+id/dayNamesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/day_names_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/dayNamesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- Periods Per Day Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/periodsPerDayLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/periods_per_day_hint"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/periodsPerDayInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Period Duration Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/periodDurationLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/period_duration_hint"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/periodDurationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Break Periods Input -->
        <TextView
            android:id="@+id/breakPeriodsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/break_periods_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/breakPeriodsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/break_periods_hint"
            android:layout_marginBottom="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/breakPeriodsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Error Message Display -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/holo_red_dark"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Next Button -->
        <Button
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/next_button"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
