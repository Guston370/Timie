<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class Timetable"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Class Section Selector -->
    <TextView
        android:id="@+id/classSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Class Section:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/classSectionSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp" />

    <!-- Variant Selector -->
    <TextView
        android:id="@+id/variantLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Timetable Variant:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/variantSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp" />

    <!-- Timetable Grid -->
    <TextView
        android:id="@+id/timetableLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Timetable:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timetableRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/viewFacultyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Faculty View"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/viewSubjectDistributionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Subject Distribution"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Edit Button -->
    <Button
        android:id="@+id/editTimetableButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Timetable"
        android:layout_marginTop="8dp" />

</LinearLayout>
